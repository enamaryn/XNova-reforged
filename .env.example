# Database
DATABASE_URL="postgresql://admin:dev_password_change_in_production@localhost:5432/xnova?schema=public"
POSTGRES_DB=xnova
POSTGRES_USER=admin
POSTGRES_PASSWORD=dev_password_change_in_production
POSTGRES_PORT=5432

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
# Production : secrets distincts d'au moins 32 caractères, sans valeur d'exemple (sinon l'API refuse de démarrer)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-me-too"
# Clé de chiffrement des secrets enregistrés en base (mot de passe SMTP). Optionnelle : à défaut JWT_SECRET
# est utilisé. La changer rend le mot de passe SMTP enregistré illisible (à ressaisir dans l'administration).
# SECRETS_ENCRYPTION_KEY=""
# Confirmation de l'adresse email obligatoire pour créer un compte et se connecter (défaut : oui). Elle exige
# un SMTP configuré dans l'administration ; sans lui, les inscriptions sont refusées (503). `false` : développement.
EMAIL_VERIFICATION_REQUIRED=false
JWT_REFRESH_EXPIRES_IN="30d"

# API
API_PORT=3001
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_ORIGINS="http://localhost:3000"  # obligatoire en production (CORS jamais ouvert)

# Limitation de débit login/register (défauts : login 10 / 60 s, register 5 / 60 s ; par IP et par compte visé)
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=60000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW_MS=60000
# Derrière un reverse proxy : nombre de proxys de confiance pour lire la vraie IP cliente
# TRUST_PROXY=1
DEV_ALLOWED_ORIGINS="http://192.168.1.64:3000"
SWAGGER_ENABLED=true
SWAGGER_PATH="api/docs"

# Frontend
PORT=3000

# Game settings
GAME_SPEED=2000
FLEET_SPEED=2200
RESOURCE_MULTIPLIER=1.25
BUILDING_COST_MULTIPLIER=1.15
RESEARCH_COST_MULTIPLIER=1.1
SHIP_COST_MULTIPLIER=1.2
MAX_BUILDING_LEVEL=100
MAX_TECH_LEVEL=100

# Debug
DEBUG_MODE=true

# Sentry (suivi d'erreurs) — OPTIONNEL. Aucun DSN réel ne doit jamais être versionné : à fournir uniquement par
# variable d'environnement de l'hébergeur. Sans DSN, l'intégration reste inactive, sans erreur.
# SENTRY_DSN=""                  # API NestJS et serveur Next
# NEXT_PUBLIC_SENTRY_DSN=""      # navigateur (DSN public) et repli du serveur Next
# SENTRY_ENV=""                  # environnement (défaut : NODE_ENV)
# Envoi des source maps à la compilation (CI/production uniquement) :
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""           # secret : jamais dans Git
